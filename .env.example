# Shopify app credentials (Partners / Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products

# Postgres (Cloud SQL in production)
DATABASE_URL=postgresql://app:app@localhost:5432/collection_adder

# Cloud Tasks queue. Leave empty locally: jobs then run in-process.
GCP_PROJECT=
GCP_LOCATION=
CLOUD_TASKS_QUEUE=
# Shared secret Cloud Tasks and Cloud Scheduler send in X-Jobs-Secret.
JOBS_SECRET=

# Seconds to wait after products/create before evaluating, so metafields are in place.
PRODUCT_CREATE_DELAY_SECONDS=120
